# Required: generate a unique random secret with at least 32 bytes.
JWT_SECRET=replace-with-a-unique-random-secret-of-at-least-32-bytes
# Comma-separated exact frontend origins. Do not use wildcards.
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# SMTP is required for password-reset email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
